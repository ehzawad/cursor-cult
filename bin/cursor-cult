#!/usr/bin/env sh
set -eu
SELF=$0
while [ -L "$SELF" ]; do
  DIR=$(CDPATH= cd -P -- "$(dirname "$SELF")" && pwd)
  LINK=$(readlink "$SELF")
  case "$LINK" in /*) SELF=$LINK ;; *) SELF=$DIR/$LINK ;; esac
done
ROOT=$(CDPATH= cd -P -- "$(dirname "$SELF")/.." && pwd)
if [ "${1:-}" = "delegate" ]; then
  shift
  exec python3 "$ROOT/scripts/cursor_delegate.py" "$@"
fi
exec python3 "$ROOT/scripts/cursor_cult.py" "$@"
